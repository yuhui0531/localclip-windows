{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalClip",
  "version": "0.1.5",
  "identifier": "com.localclip.windows",
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localclip.localhost localclip:; connect-src ipc: http://ipc.localhost http://localclip.localhost localclip:; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "template": "installer/main.wxs",
        "language": "en-US",
        "upgradeCode": "48126e85-cad0-4a2e-a6b2-388d3833d730"
      },
      "allowDowngrades": false
    },
    "publisher": "LocalClip",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/yuhui0531/localclip-windows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
